{
    "name": "modfin/bellman",
    "description": "PHP client for bellmand, the Bellman LLM proxy. One API key for OpenAI, Anthropic, Gemini, VoyageAI, Ollama and more.",
    "type": "library",
    "license": "MIT",
    "keywords": ["llm", "ai", "openai", "anthropic", "gemini", "embeddings", "bellman"],
    "homepage": "https://github.com/modfin/bellman-php",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8",
        "psr/http-client": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Bellman\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bellman\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
